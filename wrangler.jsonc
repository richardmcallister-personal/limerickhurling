{
  "name": "limerickhurling",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "limerickhurling.wiki", "custom_domain": true },
    { "pattern": "www.limerickhurling.wiki", "custom_domain": true }
  ],
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
